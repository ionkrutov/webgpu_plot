{
  "name": "webgpu-plot",
  "version": "0.1.0",
  "description": "WebGPU-accelerated 2D and 3D plotting with a MATLAB-like API (plot, subplot, surf, mesh, contour, ...)",
  "type": "module",
  "main": "./dist/webgpu-plot.js",
  "module": "./dist/webgpu-plot.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/webgpu-plot.js",
      "default": "./dist/webgpu-plot.js"
    },
    "./iife": "./dist/webgpu-plot.iife.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/webgpu-plot.js",
    "dist/webgpu-plot.js.map",
    "dist/webgpu-plot.iife.js",
    "dist/*.d.ts",
    "!dist/demo.d.ts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:types && npm run build:esm && npm run build:iife && npm run build:demo",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "esbuild src/index.ts --bundle --outfile=dist/webgpu-plot.js --format=esm --platform=browser --loader:.ttf=binary --sourcemap",
    "build:iife": "esbuild src/index.ts --bundle --outfile=dist/webgpu-plot.iife.js --format=iife --global-name=WebGPUPlot --platform=browser --loader:.ttf=binary --minify",
    "build:demo": "esbuild src/demo.ts --bundle --outfile=dist/demo.js --format=esm --platform=browser --loader:.ttf=binary --sourcemap",
    "typecheck": "tsc --noEmit",
    "watch": "esbuild src/demo.ts --bundle --outfile=dist/demo.js --format=esm --platform=browser --loader:.ttf=binary --sourcemap --watch",
    "serve": "npm run build && npx http-server -c-1",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["webgpu", "plot", "chart", "3d", "surface", "visualization", "matlab-like"],
  "author": "Ion Krutov <ionkrutov@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "earcut": "^3.0.2",
    "esbuild": "^0.27.3",
    "opentype.js": "^1.3.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/opentype.js": "^1.3.9",
    "@webgpu/types": "^0.1.69"
  }
}
